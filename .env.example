NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
# Server-only WordPress URL including /wp-json, and least-privilege application password.
WORDPRESS_API_URL=
WORDPRESS_API_USER=
WORDPRESS_API_PASSWORD=
WORDPRESS_MEDIA_HOST=
REVALIDATION_SECRET=
# In development, blank WordPress settings use the local JSON post store.
# Production publishing requires all three WordPress settings above.
# Admin login: use a unique password and a random 32+ character session secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Enable only after approved privacy wording and operational CMS/email configuration.
ENQUIRIES_ENABLED=false